# ============================================================================
# FÍDÍÒ STUDIO — Root .gitignore
# ============================================================================
# Repository: fidio-studio
#
# Policy:
# - Source code, configuration templates, migrations, tests and documentation
#   belong in Git.
# - Secrets, credentials, local databases, generated media, caches and runtime
#   state MUST NOT be committed.
# - Production/user-generated media must live in object storage, not Git.
# ============================================================================


# ============================================================================
# 1. ENVIRONMENT VARIABLES & SECRETS
# ============================================================================

.env
.env.*
!.env.example
!.env.example.*
!.env.template
!.env.template.*

# Local/developer overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secret/config files
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore

# Explicit secret directories
secrets/
.secret/
.credentials/
credentials/
.local-secrets/

# Cloud/provider credentials
.aws/
.gcloud/
.azure/
.kube/
terraform.tfvars
terraform.tfvars.json
*.tfstate
*.tfstate.*
.terraform/


